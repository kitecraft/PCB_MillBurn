# ---- Reference checkouts (third-party, GPL-3.0, not part of this product) ----
# See Documentation/01-Architecture.md section 9 (Licensing strategy).
# Everything that is not project content now lives here: the GPL-3.0 reference checkouts and the
# scratch board exports. Ignored as a whole so nothing inside it can be committed by accident.
/WorkingFolder/

# Kept as a safety net in case one is dropped back at the top level.
/pcb2gcode/
/Universal-G-Code-Sender/

# Superseded MAUI scaffold, kept on disk pending a decision (Documentation/07-UI-Framework-Decision.md).
/PCB_MillBurn/

# ---- Build output ----
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
artifacts/

# ---- Visual Studio / Rider / VS Code ----
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ---- NuGet ----
*.nupkg
*.snupkg
packages/
!packages/build/
*.nuget.props
*.nuget.targets

# ---- Test / coverage ----
[Tt]est[Rr]esult*/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.trx
# Snapshot tests: .verified.* files ARE committed, .received.* are not.
*.received.*

# ---- OS ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---- Local scratch ----
scratch/
*.local.json
*.local.md

# ---- Scratch board exports ----
# A drop zone for Gerbers that are NOT project content: work in progress, someone else's design,
# anything under NDA. Boards that earn a place in the test suite are committed to tests/boards/
# instead; MILLBURN_BOARDS repoints the fixtures at a private set without committing it.
# The scratch drop-zone: boards to try the app against, not project content. Wildcarded so the
# next one added does not quietly become a commit candidate.
MyGerbers*/
Scratch[Gg]erbers/
out/

# What a failing snapshot generated, written beside its baseline so the two can be compared. It is
# the output of a failure, not a reviewed artefact, and it must never be committed as one.
tests/MillBurn.GoldenTests/Snapshots/*.actual.txt
