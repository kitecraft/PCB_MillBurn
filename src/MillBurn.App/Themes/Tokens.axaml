<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Semantic colour tokens.

        Ported from IceLight V2's Theme_Quick_Reference.md. Use sites say

            Foreground="{DynamicResource TextPrimary}"

        instead of MAUI's per-use AppThemeBinding with a Light= and Dark= pair: Avalonia resolves
        the variant for us.

        **Every token is a brush, and every brush is declared inside a variant dictionary.** That
        is not a style preference, it is the whole mechanism, and getting it wrong is subtle:

        A brush declared *outside* ThemeDictionaries — with its Color bound by DynamicResource to a
        per-variant Color — is one shared object living in Application.Resources. It resolves its
        colour once, in the Application's variant scope, and cannot then differ between scopes or
        update when a Window's RequestedThemeVariant changes. The window keeps its light surfaces
        while the built-in Fluent brushes, which *are* per-variant, correctly switch to dark. The
        result is white button text on a white header: invisible controls and a half-flipped UI,
        with nothing logged anywhere.

        So: one brush per token per variant, literal colour, no indirection.

        Render code reads these too — MillBurn.Viewer needs SKColor, not IBrush — via a resolver
        that unwraps a SolidColorBrush. That keeps one definition per token rather than a Color and
        a Brush that can drift apart. See Documentation/01-Architecture.md section 6.
    -->

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimary" Color="#1A1C1E" />
            <SolidColorBrush x:Key="TextSecondary" Color="#5A6067" />
            <SolidColorBrush x:Key="TextHeadline" Color="#0B0D0F" />
            <SolidColorBrush x:Key="TextDisabled" Color="#9AA1A9" />

            <!-- Surfaces -->
            <SolidColorBrush x:Key="PageBackground" Color="#F5F6F8" />
            <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceVariant" Color="#E9ECEF" />
            <SolidColorBrush x:Key="ViewportBackground" Color="#FAFAFB" />
            <SolidColorBrush x:Key="ViewportGrid" Color="#E2E5E9" />

            <!-- Borders / inputs -->
            <SolidColorBrush x:Key="Border" Color="#C6CBD1" />
            <SolidColorBrush x:Key="BorderSubtle" Color="#E1E4E8" />
            <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />

            <!-- Status -->
            <SolidColorBrush x:Key="StatusSuccess" Color="#1B7F4B" />
            <SolidColorBrush x:Key="StatusError" Color="#B3261E" />
            <SolidColorBrush x:Key="StatusWarning" Color="#8A5A00" />
            <SolidColorBrush x:Key="StatusInfo" Color="#0B5FA5" />

            <!-- Interactive -->
            <SolidColorBrush x:Key="InteractivePrimary" Color="#2D5BD7" />

            <!-- Text on the accent. Dark theme's accent is light, so this flips with it. -->
            <SolidColorBrush x:Key="OnInteractivePrimary" Color="#FFFFFF" />
            <SolidColorBrush x:Key="InteractiveSecondary" Color="#6B4FC4" />
            <SolidColorBrush x:Key="InteractiveOn" Color="#FFFFFF" />

            <!-- CAM: toolpath roles. Chosen to stay distinguishable from each other and from
                 the copper underlay in both variants. -->
            <SolidColorBrush x:Key="PathIsolation" Color="#1B6FD4" />
            <SolidColorBrush x:Key="PathPocket" Color="#0E8C86" />
            <SolidColorBrush x:Key="PathDrill" Color="#B3261E" />
            <SolidColorBrush x:Key="PathOutline" Color="#7A3DBF" />
            <SolidColorBrush x:Key="PathLaser" Color="#C2410C" />
            <SolidColorBrush x:Key="PathFiducial" Color="#0B5FA5" />
            <SolidColorBrush x:Key="PathTravel" Color="#9AA1A9" />
            <SolidColorBrush x:Key="PathCut" Color="#B08000" />
            <SolidColorBrush x:Key="PathRapidLong" Color="#E06C00" />
            <SolidColorBrush x:Key="PathPending" Color="#CDD2D8" />
            <SolidColorBrush x:Key="DrcViolation" Color="#D32F2F" />
            <SolidColorBrush x:Key="CopperUnderlay" Color="#B87333" />

            <!--
                The "what this becomes" pill on a collapsed layer row. Tinted rather than filled:
                it appears once per exporting layer, so a saturated chip would be the loudest thing
                in a panel whose loudest thing should be the board.
            -->
            <SolidColorBrush x:Key="BadgeGcodeFill" Color="#FBF0D8" />
            <SolidColorBrush x:Key="BadgeGcodeEdge" Color="#DFC384" />
            <SolidColorBrush x:Key="BadgeGcodeText" Color="#6B5008" />
            <SolidColorBrush x:Key="BadgeSvgFill" Color="#E4F0FA" />
            <SolidColorBrush x:Key="BadgeSvgEdge" Color="#9FC4E0" />
            <SolidColorBrush x:Key="BadgeSvgText" Color="#0F4C75" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimary" Color="#E6E9EC" />
            <SolidColorBrush x:Key="TextSecondary" Color="#A3ABB4" />
            <SolidColorBrush x:Key="TextHeadline" Color="#F7F9FA" />
            <SolidColorBrush x:Key="TextDisabled" Color="#6B737C" />

            <!-- Surfaces -->
            <SolidColorBrush x:Key="PageBackground" Color="#14171A" />
            <SolidColorBrush x:Key="Surface" Color="#1D2125" />
            <SolidColorBrush x:Key="SurfaceVariant" Color="#272C31" />
            <SolidColorBrush x:Key="ViewportBackground" Color="#0F1214" />
            <SolidColorBrush x:Key="ViewportGrid" Color="#262B30" />

            <!-- Borders / inputs -->
            <SolidColorBrush x:Key="Border" Color="#3A4046" />
            <SolidColorBrush x:Key="BorderSubtle" Color="#2A2F34" />
            <SolidColorBrush x:Key="InputBackground" Color="#15181B" />

            <!-- Status -->
            <SolidColorBrush x:Key="StatusSuccess" Color="#4CC38A" />
            <SolidColorBrush x:Key="StatusError" Color="#FF6B6B" />
            <SolidColorBrush x:Key="StatusWarning" Color="#E3B341" />
            <SolidColorBrush x:Key="StatusInfo" Color="#5AA9F5" />

            <!-- Interactive -->
            <SolidColorBrush x:Key="InteractivePrimary" Color="#6E9BFF" />
            <SolidColorBrush x:Key="OnInteractivePrimary" Color="#0A1526" />
            <SolidColorBrush x:Key="InteractiveSecondary" Color="#A98BFF" />
            <SolidColorBrush x:Key="InteractiveOn" Color="#0F1214" />

            <!-- CAM: toolpath roles -->
            <SolidColorBrush x:Key="PathIsolation" Color="#5AA9F5" />
            <SolidColorBrush x:Key="PathPocket" Color="#3BC9C0" />
            <SolidColorBrush x:Key="PathDrill" Color="#FF6B6B" />
            <SolidColorBrush x:Key="PathOutline" Color="#B48BFF" />
            <SolidColorBrush x:Key="PathLaser" Color="#FF8A4C" />
            <SolidColorBrush x:Key="PathFiducial" Color="#7FD4FF" />
            <SolidColorBrush x:Key="PathTravel" Color="#5B646D" />
            <SolidColorBrush x:Key="PathCut" Color="#FFD740" />
            <SolidColorBrush x:Key="PathRapidLong" Color="#FFA53D" />
            <SolidColorBrush x:Key="PathPending" Color="#2E343A" />
            <SolidColorBrush x:Key="DrcViolation" Color="#FF5252" />
            <SolidColorBrush x:Key="CopperUnderlay" Color="#8A5A2B" />

            <SolidColorBrush x:Key="BadgeGcodeFill" Color="#3A2C12" />
            <SolidColorBrush x:Key="BadgeGcodeEdge" Color="#6B5326" />
            <SolidColorBrush x:Key="BadgeGcodeText" Color="#FFD08A" />
            <SolidColorBrush x:Key="BadgeSvgFill" Color="#14293C" />
            <SolidColorBrush x:Key="BadgeSvgEdge" Color="#2A5378" />
            <SolidColorBrush x:Key="BadgeSvgText" Color="#9FD5FF" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
