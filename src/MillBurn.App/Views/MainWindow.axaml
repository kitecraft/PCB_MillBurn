<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MillBurn.App.ViewModels"
        xmlns:ctl="using:MillBurn.App.Controls"
        xmlns:core="using:MillBurn.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="MillBurn.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="800"
        Background="{DynamicResource PageBackground}"
        Title="{Binding WindowTitle}">

    <Window.Styles>
        <!-- Drawer headings: the panel is a stack of sections, and they should read as one. -->
        <Style Selector="Expander /template/ ToggleButton#PART_toggle">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <!--
            The swatch carries its colour on an inner Border rather than on the Button's own
            Background. The Fluent button paints its background from theme brushes on hover and
            press, so a bound Background stops showing the layer's colour at exactly the moment
            someone is trying to click it.
        -->
        <!--
            The one action the whole app leads to. Fluent repaints a button's background from theme
            brushes on hover and press, so the accent has to be restated for those states or it
            reverts to a grey button at exactly the moment it is being clicked.
        -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource InteractivePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InteractivePrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource OnInteractivePrimary}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InteractivePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InteractivePrimary}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnInteractivePrimary}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InteractivePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InteractivePrimary}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnInteractivePrimary}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <!-- A recent project on the empty panel: a line of text to click, not a row of buttons. -->
        <Style Selector="Button.recent">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="Button.swatch">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <!--
            The disclosure is a row of text that happens to toggle, so it carries no button chrome
            of its own until the pointer is over it.
        -->
        <Style Selector="ToggleButton.disclose">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="ToggleButton.disclose:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!--
            The toolpath toggle. Deliberately not a checkbox: it sits next to one that means
            something else, and two identical boxes side by side is a guess every time. Lit in the
            cutting colour when on, and nearly invisible when off.
        -->
        <Style Selector="ToggleButton.pathtoggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
        </Style>
        <Style Selector="ToggleButton.pathtoggle:checked">
            <Setter Property="Foreground" Value="{DynamicResource PathCut}" />
        </Style>
        <Style Selector="ToggleButton.pathtoggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- What a layer becomes, on the collapsed row. -->
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        </Style>
        <Style Selector="Border.badge.gcode">
            <Setter Property="Background" Value="{DynamicResource BadgeGcodeFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeGcodeEdge}" />
        </Style>
        <Style Selector="Border.badge.gcode TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BadgeGcodeText}" />
        </Style>
        <Style Selector="Border.badge.svg">
            <Setter Property="Background" Value="{DynamicResource BadgeSvgFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeSvgEdge}" />
        </Style>
        <Style Selector="Border.badge.svg TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BadgeSvgText}" />
        </Style>

        <Style Selector="TextBlock.fact">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!--
            Header: menus carry everything, and only the three things worth reaching for without
            reading stay as buttons.
        -->
        <Border Grid.Row="0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,2">
                <Menu Grid.Column="0">
                    <!--
                        The recent list is filled when this menu opens, not when its own submenu does:
                        a MenuItem with no children is not a submenu at all, so it shows no arrow, never
                        opens, and never gets the chance to fill itself.
                    -->
                    <MenuItem Header="_File" SubmenuOpened="OnFileMenuOpened">
                        <MenuItem Header="_New project" Click="OnNewClicked" InputGesture="Ctrl+N" />
                        <MenuItem Header="_Open project…" Click="OnOpenProjectClicked" InputGesture="Ctrl+O" />
                        <MenuItem Header="Open _recent" x:Name="RecentMenu" SubmenuOpened="OnRecentOpened" />
                        <Separator />
                        <MenuItem Header="_Import Gerber folder…" Click="OnOpenFolderClicked" InputGesture="Ctrl+I" />
                        <MenuItem Header="_Refresh from source"
                                  Click="OnRefreshClicked"
                                  IsEnabled="{Binding CanRefresh}" />
                        <Separator />
                        <MenuItem Header="_Save" Click="OnSaveClicked" InputGesture="Ctrl+S" />
                        <MenuItem Header="Save _as…" Click="OnSaveAsClicked" InputGesture="Ctrl+Shift+S" />
                        <MenuItem Header="_Close project" Click="OnCloseProjectClicked" InputGesture="Ctrl+W"
                                  IsEnabled="{Binding HasBoard}" />
                        <Separator />
                        <MenuItem Header="_Export…" Click="OnExportClicked" InputGesture="Ctrl+E"
                                  IsEnabled="{Binding HasBoard}" />
                        <Separator />
                        <Separator />
                        <MenuItem Header="Open _G-code…" Click="OnOpenProgramClicked" />
                        <MenuItem Header="_Close G-code" Click="OnCloseProgramClicked"
                                  IsEnabled="{Binding HasProgram}" />
                        <Separator />
                        <MenuItem Header="E_xit" Click="OnExitClicked" />
                    </MenuItem>

                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Tool library…" Click="OnEditToolsClicked" InputGesture="Ctrl+T" />
                        <MenuItem Header="_Settings…" Click="OnSettingsClicked" InputGesture="Ctrl+," />
                        <MenuItem Header="_Start and end G-code…" Click="OnEditFramingClicked" />
                        <MenuItem Header="Reset layer _colours" Click="OnResetColoursClicked" />
                    </MenuItem>

                    <MenuItem Header="_View">
                        <MenuItem Header="_Fit to board" Click="OnFitClicked" InputGesture="Ctrl+0" />
                        <MenuItem Header="Show _all layers" Click="OnShowAllLayersClicked" />
                        <MenuItem Header="_Hide all layers" Click="OnHideAllLayersClicked" />
                        <Separator />
                        <MenuItem Header="Show all _toolpaths" Click="OnShowAllToolpathsClicked" />
                        <MenuItem Header="Hide all t_oolpaths" Click="OnHideAllToolpathsClicked" />
                        <Separator />
                        <MenuItem Header="_Expand all layer settings" Click="OnExpandLayersClicked" />
                        <MenuItem Header="_Collapse all layer settings" Click="OnCollapseLayersClicked" />
                        <Separator />
                        <MenuItem Header="Toggle light / _dark" Click="OnToggleThemeClicked" />
                    </MenuItem>

                    <MenuItem Header="_Job">
                        <MenuItem Header="_Preview programs" Click="OnPreviewClicked" InputGesture="F5"
                                  IsEnabled="{Binding HasBoard}" />
                        <MenuItem Header="_Export…" Click="OnExportClicked"
                                  IsEnabled="{Binding HasBoard}" />
                        <!--
                            Just the stock, because it is cut on its own schedule: first, and often
                            before the rest of the job is ready. Off unless the project is built on
                            stock the mill cuts to size — pre-cut stock has nothing to cut.
                        -->
                        <MenuItem Header="Cut _stock to size…" Click="OnWriteBlankClicked"
                                  IsEnabled="{Binding CanWriteBlank}" />
                        <Separator />
                        <MenuItem Header="_Reset layers to defaults…" Click="OnResetLayersClicked"
                                  IsEnabled="{Binding HasBoard}" />
                        <Separator />
                        <MenuItem Header="_Test cuts…" Click="OnTestCutsClicked" />
                        <!-- Needs no board: what it measures belongs to the machine. -->
                        <MenuItem Header="_Machine checks…" Click="OnMachineChecksClicked" />
                        <MenuItem Header="Drill _alignment…" Click="OnAlignClicked"
                                  IsEnabled="{Binding HasBoard}" />
                        <Separator />
                        <MenuItem Header="Write _probing routine…" Click="OnWriteProbeClicked"
                                  IsEnabled="{Binding HasBoard}" />
                        <MenuItem Header="_Import height map…" Click="OnImportHeightMapClicked" />
                        <MenuItem Header="_Forget height map" Click="OnForgetHeightMapClicked"
                                  IsEnabled="{Binding HasSurface}" />
                    </MenuItem>

                    <MenuItem Header="_Help">
                        <MenuItem Header="_Help contents" Click="OnHelpClicked" InputGesture="F1" />
                        <MenuItem Header="_Questions and answers" Click="OnFaqClicked" />
                        <MenuItem Header="_Guides">
                            <MenuItem Header="_Exporting from KiCad" Click="OnKiCadExportGuideClicked" />
                            <MenuItem Header="_Drill alignment" Click="OnDrillAlignmentGuideClicked" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="_About PCB_MillBurn" Click="OnAboutClicked" />
                    </MenuItem>
                </Menu>

                <TextBlock Grid.Column="1"
                           Text="{Binding BoardTitle}"
                           Margin="18,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondary}" />

                <!--
                    The two ends of the job first, then the three conveniences. Preview and Export
                    lived at the bottom of the board pane, under a heading, behind a filter that
                    duplicated what every layer row now says for itself. They are what the app is
                    for; they belong where they can be reached without reading anything.
                -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,2">
                    <Button Content="Preview" Click="OnPreviewClicked"
                            IsEnabled="{Binding HasBoard}"
                            ToolTip.Tip="Draw the emitted G-code back over the board (F5)" />
                    <Button Classes="primary" Content="Export…" Click="OnExportClicked"
                            IsEnabled="{Binding HasBoard}"
                            ToolTip.Tip="Review every file, then choose where they go (Ctrl+E)" />

                    <Border Width="1" Margin="5,4"
                            Background="{DynamicResource BorderSubtle}" />

                    <Button Content="Save" Click="OnSaveClicked"
                            ToolTip.Tip="Save the project (Ctrl+S)" />
                    <Button Content="Fit" Click="OnFitClicked"
                            ToolTip.Tip="Fit the board to the window (Ctrl+0)" />
                    <Button Content="Tools" Click="OnEditToolsClicked"
                            ToolTip.Tip="Edit the saved tool library (Ctrl+T)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Panel | viewport -->
        <!--
            The first column's width is restored from settings on open and saved on close, the same
            as the window's own placement. Resizing the same panel at every start is a small
            irritation that never stops being one.
        -->
        <Grid Grid.Row="1" ColumnDefinitions="380,4,*" x:Name="Split">

            <Border Grid.Column="0"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="*,Auto,Auto" Margin="10,10,10,0">

                    <!--
                        Project info and Layers share one scroller, and Export is pinned under it.
                        Giving the layer list a guaranteed minimum instead made it overlap its own
                        heading on a short window: a minimum cannot shrink, so the panel overflowed
                        rather than scrolled.
                    -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- Nothing open: the two ways in, and nothing else to read. -->
                            <StackPanel Spacing="8" IsVisible="{Binding ShowingNothing}" Margin="2,8">
                                <TextBlock Text="No project open"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextHeadline}" />
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="Import a Gerber export folder, or open a project you saved earlier." />
                                <Button Content="New project" Click="OnNewClicked"
                                        HorizontalAlignment="Stretch"
                                        ToolTip.Tip="Start over with nothing loaded (Ctrl+N)" />
                                <Button Content="Import Gerber folder…" Click="OnOpenFolderClicked"
                                        HorizontalAlignment="Stretch"
                                        ToolTip.Tip="Read a folder of Gerber and drill files (Ctrl+I)" />
                                <Button Content="Open project…" Click="OnOpenProjectClicked"
                                        HorizontalAlignment="Stretch"
                                        ToolTip.Tip="Open a .millburn project (Ctrl+O)" />

                                <!-- The same list as File ▸ Open recent, filled whenever this panel shows. -->
                                <StackPanel x:Name="RecentPanel" Spacing="0" Margin="0,10,0,0" />
                            </StackPanel>

                            <!-- PROJECT INFO -->
                            <Expander Header="Project info" IsExpanded="True" IsVisible="{Binding HasBoard}">
                                <StackPanel Spacing="6" Margin="0,4">
                                    <ItemsControl ItemsSource="{Binding Facts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Classes="fact" Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Classes="caption" Width="92"
                                                   VerticalAlignment="Center"
                                                   Text="Board thickness" />
                                        <Slider Grid.Column="1" Minimum="0.4" Maximum="3.2"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Value="{Binding BoardThicknessMm, Mode=TwoWay}"
                                                Margin="6,0"
                                                ToolTip.Tip="Stock thickness, saved with the project. Drilling and the outline go through this; isolation does not." />
                                        <TextBlock Grid.Column="2" Classes="fact"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding BoardThicknessMm, StringFormat='{}{0:F1} mm'}" />
                                    </Grid>

                                    <TextBlock Text="{Binding ThicknessNote}"
                                               Classes="caption"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding ThicknessNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                    <!--
                                        The stock: the piece of copper-clad this job is built on, and the
                                        datum for every machine after it. Off by default because it
                                        moves work zero.
                                    -->
                                    <CheckBox IsChecked="{Binding UseBlank, Mode=TwoWay}"
                                              Margin="0,6,0,0"
                                              ToolTip.Tip="Reference every file to a piece of stock rather than to the board. Work zero becomes the stock's lower-left corner, the SVG page becomes the stock, and a mirrored layer flips about the stock's centreline.">
                                        <TextBlock Text="Build on stock" Classes="caption" />
                                    </CheckBox>

                                    <StackPanel Spacing="4" IsVisible="{Binding UseBlank}" Margin="18,0,0,0">
                                        <CheckBox IsChecked="{Binding BlankIsStated, Mode=TwoWay}"
                                                  ToolTip.Tip="Give the stock's own size instead of a border round the board — for stock that is already cut.">
                                            <TextBlock Text="Pre-cut size" Classes="caption" />
                                        </CheckBox>

                                        <Grid ColumnDefinitions="Auto,*,Auto,*" IsVisible="{Binding BlankIsStated}">
                                            <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center" Text="W" Margin="0,0,4,0" />
                                            <TextBox Grid.Column="1" Text="{Binding BlankWidthMm, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="2" Classes="caption" VerticalAlignment="Center" Text="H" Margin="8,0,4,0" />
                                            <TextBox Grid.Column="3" Text="{Binding BlankHeightMm, Mode=TwoWay}" />
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Grid.IsVisible>
                                                <Binding Path="BlankIsStated" Converter="{x:Static BoolConverters.Not}" />
                                            </Grid.IsVisible>
                                            <TextBlock Grid.Column="0" Classes="caption" Width="92"
                                                       VerticalAlignment="Center" Text="Border" />
                                            <Slider Grid.Column="1" Minimum="3" Maximum="30"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding BlankBorderMm, Mode=TwoWay}"
                                                    Margin="6,0" />
                                            <TextBlock Grid.Column="2" Classes="fact" VerticalAlignment="Center"
                                                       Text="{Binding BlankBorderMm, StringFormat='{}{0:F0} mm'}" />
                                        </Grid>

                                        <CheckBox IsChecked="{Binding CutTheBlank, Mode=TwoWay}"
                                                  ToolTip.Tip="Cut with the bit chosen for the Board outline layer, so the stock and the board need no tool change. Off when the stock is already this size — nothing is cut, and the app is simply told what is on the table.">
                                            <TextBlock Text="Cut the stock to size on the mill" Classes="caption" />
                                        </CheckBox>

                                        <CheckBox IsChecked="{Binding StockAlignmentHoles, Mode=TwoWay}"
                                                  IsEnabled="{Binding CutTheBlank}"
                                                  ToolTip.Tip="Two small holes in the waste border, cut with the same bit before the edges are cut. A later setup can be checked against them with Job ▸ Drill alignment, before anything is cut into the board.">
                                            <TextBlock Text="Alignment holes in the waste" Classes="caption" />
                                        </CheckBox>

                                        <CheckBox IsChecked="{Binding StockHolesOnly, Mode=TwoWay}"
                                                  IsVisible="{Binding CanAskForHolesOnly}"
                                                  Margin="18,0,0,0"
                                                  ToolTip.Tip="The stock is already this size: drill only the two alignment holes into it, and leave its edges alone. Put it in the corner stop the right way up first — its lower-left corner is work zero.">
                                            <TextBlock Text="Export only the alignment holes" Classes="caption" />
                                        </CheckBox>

                                        <TextBlock Text="{Binding BlankSummary}"
                                                   Classes="caption"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding BlankSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>

                                    <!--
                                        Job options: choices about this board rather than about the
                                        machine or one layer. Off by default, because turning it on
                                        changes a hole from drilled to milled and that should be a
                                        decision somebody made rather than one they inherited.
                                    -->
                                    <CheckBox IsChecked="{Binding MillLargeHoles, Mode=TwoWay}"
                                              Margin="0,2,0,0"
                                              ToolTip.Tip="Holes bigger than the largest drill in your tool library are spiralled out with an end mill instead of being refused. They go in the routing file beside the drilling program.">
                                        <TextBlock Text="Mill holes too big to drill" Classes="caption" />
                                    </CheckBox>

                                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding MillLargeHoles}">
                                        <TextBlock Grid.Column="0" Classes="caption" Width="92"
                                                   VerticalAlignment="Center"
                                                   Text="Spiral with" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding MillDrillTools}"
                                                  SelectedItem="{Binding MillDrillTool, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  PlaceholderText="Widest that fits"
                                                  ToolTip.Tip="Used for the milled holes and the slots wherever it fits, so they share one routing file. Anything it does not fit gets the widest end mill that does. Leave unset to take the widest that fits each one.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="core:Tool">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,6,*">
                                        <Button Grid.Column="0" Content="Import folder…"
                                                Click="OnOpenFolderClicked"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                ToolTip.Tip="Replace the board with a different Gerber folder (Ctrl+I)" />
                                        <Button Grid.Column="2" Content="Refresh source"
                                                Click="OnRefreshClicked"
                                                IsEnabled="{Binding CanRefresh}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                ToolTip.Tip="Look for changes in the folder this project was imported from. Nothing is applied until you have seen it." />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <!-- LAYERS -->
                            <!--
                                Grouped by which part of the board a layer belongs to, not by paint
                                order. Paint order is right for the renderer and wrong here: it puts
                                bottom silk at the top of the list and interleaves the two sides
                                where they are hardest to tell apart.
                            -->
                            <Expander Header="Layers" IsExpanded="True" IsVisible="{Binding HasLayerRows}">
                                <ItemsControl ItemsSource="{Binding LayerGroups}" Margin="0,4,6,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LayerGroup">
                                            <StackPanel Margin="0,0,0,9">
                                                <Grid ColumnDefinitions="*,Auto" Margin="2,5,2,3">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Title}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Summary}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextDisabled}" />
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LayerRow">
                                            <Border Padding="4,3" Margin="0,1" CornerRadius="4"
                                                    BorderBrush="{DynamicResource BorderSubtle}"
                                                    BorderThickness="0,0,0,1">
                                                <!--
                                                    Isolating gestures live here rather than in a
                                                    menu because both of them need to know *which*
                                                    layer, and a menu would then need a selected
                                                    row — a third piece of state the list does not
                                                    otherwise have.
                                                -->
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Show only this toolpath"
                                                                  Click="OnOnlyToolpathClicked"
                                                                  IsEnabled="{Binding HasToolpath}" />
                                                        <MenuItem Header="Show all toolpaths"
                                                                  Click="OnShowAllToolpathsClicked" />
                                                        <Separator />
                                                        <MenuItem Header="Export only this layer…"
                                                                  Click="OnOnlyExportClicked" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <!--
                                                    The header is one row and the settings are a
                                                    sibling underneath it, not a child of its third
                                                    column. Nesting them left the checkbox and
                                                    swatch stranded at the top of a column as tall
                                                    as the open panel, with everything indented past
                                                    the empty gutter that made.
                                                -->
                                                <StackPanel>
                                                    <!--
                                                        Two toggles, deliberately unalike. The
                                                        artwork is a checkbox and the toolpath is a
                                                        path glyph, because two identical
                                                        checkboxes side by side is a coin toss
                                                        every time — and these control genuinely
                                                        different things: the copper underneath
                                                        hides the cuts drawn over it, so isolating
                                                        a toolpath means turning one off and the
                                                        other on.
                                                    -->
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip.Tip="Draw this layer's artwork. Nothing to do with what gets exported." />

                                                        <ToggleButton Grid.Column="1"
                                                                      Classes="pathtoggle"
                                                                      IsChecked="{Binding ShowToolpath, Mode=TwoWay}"
                                                                      IsVisible="{Binding HasToolpath}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="2,0,4,0"
                                                                      ToolTip.Tip="Draw this layer's toolpath. Turn the artwork off to see it clearly.">
                                                            <Path Data="M1,10 L5,4 L9,8 L15,2"
                                                                  Stroke="{Binding $parent[ToggleButton].Foreground}"
                                                                  StrokeThickness="1.8"
                                                                  StrokeLineCap="Round"
                                                                  Width="16" Height="12" />
                                                        </ToggleButton>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="–"
                                                                   IsVisible="{Binding !HasToolpath}"
                                                                   Width="20"
                                                                   Margin="2,0,4,0"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextDisabled}"
                                                                   ToolTip.Tip="This layer makes no program." />

                                                        <Button Grid.Column="2"
                                                                Classes="swatch"
                                                                Width="16" Height="16"
                                                                Margin="0,0,8,0"
                                                                VerticalAlignment="Center"
                                                                Click="OnSwatchClicked"
                                                                ToolTip.Tip="Change this layer colour">
                                                            <Border Background="{Binding Swatch}"
                                                                    BorderBrush="{DynamicResource BorderSubtle}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="2" />
                                                        </Button>

                                                        <ToggleButton Grid.Column="3"
                                                                      Classes="disclose"
                                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                      HorizontalAlignment="Stretch"
                                                                      HorizontalContentAlignment="Stretch"
                                                                      ToolTip.Tip="Show what this layer becomes">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Label}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextPrimary}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Chevron}"
                                                                           FontSize="14"
                                                                           Margin="6,0,4,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextPrimary}" />
                                                            </Grid>
                                                        </ToggleButton>

                                                        <!--
                                                            What this layer becomes, on the
                                                            collapsed row. Without it the row said
                                                            nothing at all about export unless it
                                                            was opened.
                                                        -->
                                                        <Border Grid.Column="4"
                                                                Classes.gcode="{Binding IsGcode}"
                                                                Classes.svg="{Binding IsSvg}"
                                                                Classes="badge"
                                                                IsVisible="{Binding HasExportBadge}"
                                                                VerticalAlignment="Center"
                                                                Margin="4,0,2,0">
                                                            <TextBlock Text="{Binding ExportBadge}"
                                                                       FontSize="10.5" />
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Spacing="3"
                                                                Margin="26,3,0,4"
                                                                IsVisible="{Binding IsExpanded}">

                                                    <ComboBox ItemsSource="{Binding Outputs}"
                                                              SelectedItem="{Binding SelectedOutput, Mode=TwoWay}"
                                                              IsVisible="{Binding CanExport}"
                                                              HorizontalAlignment="Stretch"
                                                              Margin="0"
                                                              ToolTip.Tip="What this layer becomes. Each exported layer gets its own file." />

                                                    <ComboBox ItemsSource="{Binding Tools}"
                                                              SelectedItem="{Binding Tool, Mode=TwoWay}"
                                                              IsVisible="{Binding IsGcode}"
                                                              HorizontalAlignment="Stretch"
                                                              Margin="0"
                                                              ToolTip.Tip="Which tool cuts this layer">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <Grid ColumnDefinitions="Auto,*" Margin="0"
                                                          IsVisible="{Binding NeedsDepth}">
                                                        <TextBlock Grid.Column="0" Classes="caption" Width="78"
                                                                   VerticalAlignment="Center" Text="Depth (mm)" />
                                                        <NumericUpDown Grid.Column="1"
                                                                       Minimum="0.005" Maximum="1.0"
                                                                       Increment="0.005"
                                                                       FormatString="0.000"
                                                                       Value="{Binding DepthMm, Mode=TwoWay}"
                                                                       ToolTip.Tip="How deep the cut runs. For a V-bit this is the same choice as how wide it cuts." />
                                                    </Grid>

                                                    <!--
                                                        The moat, not the lap count. How many laps
                                                        it takes depends on what the bit cuts at
                                                        this depth, which is itself derived — so
                                                        asking for passes means doing that sum in
                                                        your head. The sum is printed underneath
                                                        instead.
                                                    -->
                                                    <StackPanel IsVisible="{Binding NeedsPasses}">
                                                        <Grid ColumnDefinitions="Auto,*" Margin="0">
                                                            <TextBlock Grid.Column="0" Classes="caption" Width="78"
                                                                       VerticalAlignment="Center" Text="Isolate (mm)" />
                                                            <NumericUpDown Grid.Column="1"
                                                                           Minimum="0" Maximum="5" Increment="0.05"
                                                                           FormatString="0.00"
                                                                           Value="{Binding IsolationWidthMm, Mode=TwoWay}"
                                                                           ToolTip.Tip="How wide a gap to clear either side of every trace. Zero cuts one lap, whatever the bit happens to be." />
                                                        </Grid>
                                                        <TextBlock Classes="caption"
                                                                   Margin="78,2,0,0"
                                                                   Text="{Binding IsolationExplanation}" />
                                                    </StackPanel>

                                                    <Grid ColumnDefinitions="Auto,*" Margin="0"
                                                          IsVisible="{Binding NeedsBreakThrough}">
                                                        <TextBlock Grid.Column="0" Classes="caption" Width="78"
                                                                   VerticalAlignment="Center" Text="Through (mm)" />
                                                        <NumericUpDown Grid.Column="1"
                                                                       Minimum="0.0" Maximum="2.0"
                                                                       Increment="0.05"
                                                                       FormatString="0.00"
                                                                       Value="{Binding BreakThroughMm, Mode=TwoWay}"
                                                                       ToolTip.Tip="How far past the underside to go. Stopping exactly at the nominal thickness leaves a skin that tears." />
                                                    </Grid>

                                                    <Grid ColumnDefinitions="Auto,*" Margin="0"
                                                          IsVisible="{Binding NeedsTabs}">
                                                        <TextBlock Grid.Column="0" Classes="caption" Width="78"
                                                                   VerticalAlignment="Center" Text="Tabs" />
                                                        <NumericUpDown Grid.Column="1"
                                                                       Minimum="0" Maximum="12" Increment="1"
                                                                       FormatString="0"
                                                                       Value="{Binding TabCount, Mode=TwoWay}"
                                                                       ToolTip.Tip="Uncut bridges holding the board in the stock. Zero cuts it fully free, and the last pass throws it." />
                                                    </Grid>

                                                    <CheckBox Content="Drilling guide"
                                                              Margin="0"
                                                              MinHeight="0"
                                                              IsVisible="{Binding NeedsDrillGuide}"
                                                              IsChecked="{Binding DrillGuide, Mode=TwoWay}"
                                                              ToolTip.Tip="Write a page beside the program listing the bits in order, their hole counts, and when it stops to change them." />

                                                    <CheckBox Content="Mirrored"
                                                              Margin="0"
                                                              MinHeight="0"
                                                              IsVisible="{Binding NeedsMirror}"
                                                              IsChecked="{Binding Mirrored, Mode=TwoWay}"
                                                              ToolTip.Tip="Reflect this layer left-to-right, for work done after the stock is flipped. On by default for bottom-side layers." />

                                                    <CheckBox Content="Inverted"
                                                              Margin="0"
                                                              MinHeight="0"
                                                              IsVisible="{Binding NeedsInvert}"
                                                              IsChecked="{Binding Invert, Mode=TwoWay}"
                                                              ToolTip.Tip="Burn everything inside the board edge EXCEPT this layer, for clearing resist off a painted board so acid can reach it. Off means burn the shapes themselves." />

                                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                                               Margin="0"
                                                               Text="{Binding Detail}" />

                                                        <TextBlock FontSize="11"
                                                                   FontFamily="Consolas,monospace"
                                                                   Foreground="{DynamicResource StatusInfo}"
                                                                   IsVisible="{Binding TargetName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                   Text="{Binding TargetName}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <!--
                                Kinds of move, and the substrate. These were rows in the layer list,
                                which is what they are not: no file makes one, none can be exported,
                                and every setting a layer row offers is meaningless for them. What
                                they are is a filter across the whole drawing.
                            -->
                            <Border IsVisible="{Binding HasMoveKinds}"
                                    Margin="0,6,6,0" Padding="8,7"
                                    CornerRadius="6"
                                    Background="{DynamicResource SurfaceVariant}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Toolpath moves"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <ItemsControl ItemsSource="{Binding MoveKinds}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MoveKindRow">
                                                <!--
                                                    The dot is a button in its own right, and sits
                                                    outside the checkbox rather than inside its
                                                    content: these are the colours most likely to
                                                    need changing — a program drawn over the copper
                                                    it was made from — and nesting a button inside
                                                    a checkbox makes one click mean two things.
                                                -->
                                                <StackPanel Orientation="Horizontal" Spacing="5"
                                                            Margin="0,0,14,0">
                                                    <Button Classes="swatch"
                                                            Width="10" Height="10"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding HasColour}"
                                                            Click="OnKindSwatchClicked"
                                                            ToolTip.Tip="Change this colour">
                                                        <Border CornerRadius="5"
                                                                BorderBrush="{DynamicResource BorderSubtle}"
                                                                BorderThickness="1"
                                                                Background="{Binding Swatch}" />
                                                    </Button>
                                                    <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                              MinHeight="0">
                                                        <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                                   VerticalAlignment="Center" />
                                                    </CheckBox>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--
                        Refresh review. Nothing is applied until it has been seen: a CAM tool that
                        swaps geometry underneath you without saying what changed is how a board
                        gets scrapped.
                    -->
                    <Border Grid.Row="1"
                            IsVisible="{Binding RefreshSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,1,0,0"
                            Margin="0,10,0,0"
                            Padding="12,10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="REFRESH FROM SOURCE"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding RefreshSummary}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <!--
                                The cap belongs on a ScrollViewer, not on the ItemsControl: an
                                ItemsControl does not scroll, so a MaxHeight on it alone sliced the
                                sixth of nine files in half and hid the rest with nothing to say so.
                                Every file here is a change the operator is being asked to approve,
                                so one that cannot be reached is one that gets applied unread.
                            -->
                            <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding RefreshItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RefreshItem">
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,2,6,0">
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding Selected, Mode=TwoWay}"
                                                          VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Text="{Binding Detail}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Apply" Click="OnApplyRefreshClicked"
                                        IsVisible="{Binding RefreshItems.Count}"
                                        ToolTip.Tip="Take the ticked changes into this project" />
                                <Button Content="Close" Click="OnCancelRefreshClicked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--
                        Anything worth checking before trusting what is on screen.

                        Capped and scrolled. This row is Auto-sized and the layer list above it is
                        the star-sized one, so without a ceiling a long enough set of checks pushes
                        the whole list off the window — which is what happened the first time an
                        export refused five files and explained itself five times. A panel that
                        grows without limit takes the space from whatever is above it, and here
                        that is the thing the operator was looking at.
                    -->
                    <Border Grid.Row="2"
                            IsVisible="{Binding Warnings.Count}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,1,0,0"
                            Margin="0,10,0,0"
                            Padding="12,8">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                                <TextBlock Grid.Column="0" Text="CHECK"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DrcViolation}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding WarningCount}"
                                           FontSize="11"
                                           Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextDisabled}" />
                            </Grid>
                            <ScrollViewer MaxHeight="170" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Warnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,1,6,3"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Background="{DynamicResource BorderSubtle}" />

            <Panel Grid.Column="2">
                <ctl:BoardView x:Name="Viewport" Scene="{Binding Scene}" />

                <!-- Kept for the fpstest harness: it measures the real Phase 0 render loop. -->
                <ctl:ToolpathView x:Name="ToolpathViewport"
                                  Scene="{Binding ToolpathScene}"
                                  IsVisible="False" />

                <Border IsVisible="{Binding ShowingNothing}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="28,22">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="Drop a Gerber export folder here"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextHeadline}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="KiCad, Altium or Eagle output, drill files included"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Panel>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <!--
                The message wins, and the summaries show in full whenever they fit: when the row is
                too narrow they give way from the last (frame timing) to the first, and the message
                trims only after all of them. See StatusBarPanel for why a Grid could not do both.
            -->
            <ctl:StatusBarPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           ClipToBounds="True"
                           ToolTip.Tip="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding GcodeSummary}"
                           ClipToBounds="True"
                           ToolTip.Tip="{Binding GcodeSummary}"
                           TextTrimming="CharacterEllipsis"
                           Margin="16,0"
                           Foreground="{DynamicResource StatusInfo}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding BoardSummary}"
                           ClipToBounds="True"
                           ToolTip.Tip="{Binding BoardSummary}"
                           TextTrimming="CharacterEllipsis"
                           Margin="16,0"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding FrameSummary}"
                           ClipToBounds="True"
                           ToolTip.Tip="{Binding FrameSummary}"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="Consolas,monospace"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" />
            </ctl:StatusBarPanel>
        </Border>
    </Grid>
</Window>
