<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The board locator is shared with MillBurn.Tests rather than duplicated: one definition of where
    the boards are, so the two assemblies cannot disagree. The boards themselves are committed, and
    the locator throws when they are missing — a checkout without them is broken rather than partial.
  -->
  <ItemGroup>
    <Compile Include="..\MillBurn.Tests\RealBoards.cs" Link="RealBoards.cs" />

    <!--
      Story 3's cancellation fixture, shared the same way and for the same reason. Its tests are
      split across the two assemblies on purpose: the ones that read the global work and memo
      counters have to run where classes do not run in parallel, and the rest do not.
    -->
    <Compile Include="..\MillBurn.Tests\PlanningCancellationFixture.cs" Link="PlanningCancellationFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MillBurn.Pipeline\MillBurn.Pipeline.csproj" />
    <ProjectReference Include="..\..\src\MillBurn.Viewer\MillBurn.Viewer.csproj" />
  </ItemGroup>

</Project>